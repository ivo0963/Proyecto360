# Client ID y Tenant ID de la app Pedidos360-FRONTEND (Overview) — NO el de la API
VITE_AZURE_CLIENT_ID=xxxxxxxx
VITE_AZURE_TENANT_ID=xxxxxxxx
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Backend protegido: AWS API Gateway (HTTP API) + JWT authorizer (Entra ID)
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Scopes de la app Pedidos360-API (Exponer una API), separados por espacio.
# <backend-client-id> = Application (client) ID de Pedidos360-API.
# Todos deben tener "Grant admin consent" en Pedidos360-Frontend (API permissions).
VITE_API_SCOPE=api://<backend-client-id>/orders.read api://<backend-client-id>/orders.write api://<backend-client-id>/catalog.read api://<backend-client-id>/catalog.write
